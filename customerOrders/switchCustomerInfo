using System;

string customerType = "R";

switch (customerType)
{
    case "R":
        Console.WriteLine("You are a regular customer.");
        break;
    case "C":
        Console.WriteLine("You are a commercial customer.");
        break;
    case "G":
        Console.WriteLine("You are a government customer.");
        break;
    default:
        Console.WriteLine("Customer type not recognized.");
        break;
}