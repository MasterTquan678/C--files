using System;
using System.Collections.Generic;

namespace StudentGradeManager 
{
    class Program 
    {
        static void Main(string[] args) 
        {
            Dictionary<string, int> students = new Dictionary<string, int>
        {
            { "Alice", 90 },
            { "Bob", 85 },
            { "Charlie", 95 }
        };

        // 2. Add a new pair
        students.Add("Diana", 88);
        // Or using indexer syntax:
        students["Evan"] = 92;

        // 3. Retrieve a value by key
        Console.WriteLine($"Alice's grade: {students["Alice"]}");

        // 4. Iterate through the dictionary
        foreach (KeyValuePair<string, int> kvp in students)
        {
            Console.WriteLine($"Name: {kvp.Key}, Grade: {kvp.Value}");
        }
        while (true)
        {
            Console.Write("\nEnter student name (or 'exit' to stop): ");
            string name = Console.ReadLine();

            // Check for sentinel value to break the loop
            if (name != null && name.Equals("exit", StringComparison.OrdinalIgnoreCase))
            {
                break;
            }

            Console.Write("Enter student grade: ");
            string Input = Console.ReadLine();

            // Display the recorded entry
            Console.WriteLine($"Recorded: Name = {name}, Grade = {Input}");
        }

        Console.WriteLine("\nProgram exited. Goodbye!");

        onsole.WriteLine("\nProgram exited. Goodbye!");
			Console.WriteLine("Enter name:");
string inputName = Console.ReadLine();

while (string.IsNullOrWhiteSpace(inputName))
{
    Console.WriteLine("Name cannot be empty or whitespace. Please enter a valid name:");
    inputName = Console.ReadLine();
}
		Console.WriteLine("Enter grade (0-100):");
string inputGrade = Console.ReadLine();
        int grade;
        while(!int.TryParse(inputGrade, out grade))
        {
            Console.Write("Invalid grade. Please enter a number between  0 and 100: ");
            inputGrade = Console.ReadLine();
        }
        Console.Write("Enter a number: ");
			string userInput = Console.ReadLine();
        try
        {
            // Attempt to parse the user input string into an integer
            int parsedNumber = int.Parse(userInput);
            
            // If successful, display the result
            Console.WriteLine($"Success! You entered the number: {parsedNumber}");
        }
        catch (FormatException)
        {
            // Triggers if the input is not a valid number (e.g., "abc")
            Console.WriteLine("Please enter a valid number.");
        }
        catch (OverflowException)
        {
            // Triggers if the number is too large or too small for an int
            Console.WriteLine("The number you entered is too large or too small.");
        }
        catch (Exception ex)
        {
            // Triggers for any other unexpected errors
            Console.WriteLine($"Unexpected error: {ex.Message}");
      }

     }
   }
}